# Smaller Alpine-based development environment (2026)
FROM golang:1.27.1-alpine

ARG USER=nonroot
ENV HOME=/home/$USER
ENV PATH="/usr/local/go/bin:${HOME}/go/bin:${PATH}"

# Install shell, development, container, Kubernetes, and protobuf tools.
RUN apk add --no-cache \
    bash \
    curl \
    docker-bash-completion \
    docker-cli \
    docker-cli-buildx \
    docker-cli-compose \
    docker-zsh-completion \
    emacs \
    gcc \
    git \
    kubectl \
    kubectl-bash-completion \
    kubectl-zsh-completion \
    kubectx \
    kubectx-bash-completion \
    kubectx-zsh-completion \
    libgcc \
    make \
    musl-dev \
    protobuf \
    sudo \
    vim \
    zsh

# Add an unprivileged development user with passwordless sudo.
RUN adduser -D "$USER" \
    && echo "$USER ALL=(ALL) NOPASSWD: ALL" > "/etc/sudoers.d/$USER" \
    && chmod 0440 "/etc/sudoers.d/$USER"

USER $USER
WORKDIR $HOME

# Go development tools (Sep 2026).
RUN go install golang.org/x/tools/cmd/goimports@v0.50.0 \
    && go install golang.org/x/tools/gopls@v0.23.0 \
    && go install honnef.co/go/tools/cmd/staticcheck@v0.7.0 \
    && go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@v1.6.2 \
    && go install google.golang.org/protobuf/cmd/protoc-gen-go@v1.36.11

# Retained for compatibility with existing course workflows.
RUN go install golang.org/x/tools/cmd/godoc@v0.1.0-deprecated

# Build: docker build -f Dockerfile.alpine -t ghcr.io/yryang/cs426-fall26-devenv:latest .
# Start: docker run -it -v myhomedir:/home/nonroot ghcr.io/yryang/cs426-fall26-devenv:latest /bin/bash
CMD ["bash"]
